{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DebuggingInput",
  "type": "object",
  "required": ["taskId", "issue", "repositoryUri", "failureEvidenceRefs"],
  "properties": {
    "taskId": {"type": "string", "minLength": 1},
    "issue": {"type": "string", "minLength": 1},
    "repositoryUri": {"type": "string", "minLength": 1},
    "failureEvidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
