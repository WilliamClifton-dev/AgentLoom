{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentloom.dev/schemas/skills/patch-scope-input.schema.json",
  "title": "Patch Scope Validator Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["patch", "patchSha256", "allowedPaths"],
  "properties": {
    "patch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 131072,
      "description": "Canonical unified diff; the Provider also enforces a 128 KiB UTF-8 byte limit."
    },
    "patchSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    }
  }
}
