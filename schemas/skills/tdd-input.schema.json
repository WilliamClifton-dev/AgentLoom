{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TddInput",
  "type": "object",
  "required": ["taskId", "rootCauseReportRef", "acceptanceCriteria", "allowedPaths"],
  "properties": {
    "taskId": {"type": "string", "minLength": 1},
    "rootCauseReportRef": {"type": "string", "minLength": 1},
    "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowedPaths": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
